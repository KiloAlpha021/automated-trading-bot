{
  "name": "@atis/operator-console",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "description": "ATIS Operator Console visual and navigation implementation.",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.app.json --pretty false && vite build",
    "typecheck": "tsc -p tsconfig.app.json --pretty false",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "audit:dependencies": "npm audit --audit-level=high",
    "sbom": "npm sbom --sbom-format=cyclonedx > operator-console.sbom.json"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

