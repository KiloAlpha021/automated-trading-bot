        },
        "current_substantive_status": {
          "type": "string",
          "minLength": 1
        },
        "verbatim_source_recovered": {
          "type": "boolean"
        },
        "engineering_impact": {
          "type": "string",
          "minLength": 1
        },
        "affected_controls": {
