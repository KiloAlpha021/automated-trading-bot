{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gate_id",
    "s3req036",
    "owner_acceptance",
    "gate_result",
    "reasons"
  ],
  "properties": {
    "gate_id": {
      "const": "GATE-S03-01"
    },
    "s3req036": {
      "enum": [
        "NOT_ESTABLISHED",
        "EVIDENCE_STRUCTURE_VERIFIED",
        "CURRENT_EVIDENCE_COMPLETE"
      ]
    },
    "owner_acceptance": {
      "enum": [
        "NO_APPROVED_OWNER_VERDICT",
        "AUTHENTICATED_OWNER_PASS"
      ]
    },
    "gate_result": {
      "enum": [
        "NOT_ESTABLISHED",
        "READY_FOR_AUTHORIZED_EXECUTION"
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
