{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "requirements",
    "properties",
    "historical_review",
    "material_blockers",
    "independent_review"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "sources",
          "direct_tests",
          "adversarial_tests",
          "execution_evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "CURRENT",
              "STALE",
              "INVALIDATED",
              "INSUFFICIENT",
              "UNKNOWN",
              "CONTRADICTORY"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "blob"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "blob": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              }
            }
          },
          "direct_tests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "blob"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "blob": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "nodeid": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "adversarial_tests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "blob"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "blob": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "nodeid": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "execution_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "blob"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "blob": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                }
              }
            }
          }
        }
      }
    },
    "properties": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "historical_record",
          "invalidation_conditions",
          "reconciled_invalidators",
          "requirements",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "CURRENT",
              "NOT_ESTABLISHED",
              "INVALIDATED"
            ]
          },
          "historical_record": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "blob"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "blob": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          },
          "invalidation_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reconciled_invalidators": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "historical_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "state",
        "limitations",
        "independent_acceptance"
      ],
      "properties": {
        "record": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "blob"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "blob": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "state": {
          "enum": [
            "CURRENT",
            "NOT_ESTABLISHED"
          ]
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "independent_acceptance": {
          "const": false
        },
        "provenance_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "material_blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "independent_review": {
      "const": "DEFERRED_BY_OWNER"
    }
  },
