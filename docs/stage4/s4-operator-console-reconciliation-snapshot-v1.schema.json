{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atis.invalid/contracts/operator-console/reconciliation-snapshot-v1.schema.json",
  "title": "ATIS Operator Console Reconciliation Snapshot V1",
  "description": "Immutable research-simulation reconciliation truth. It grants no trading authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "source_authority",
    "source_run_id",
    "evidence_refs",
    "evidence_digest",
    "reconciliation_state",
    "discrepancy_codes",
    "observed_at_utc",
    "produced_at_utc",
    "freshness_state",
    "simulation_only",
    "trading_authority",
    "performance"
  ],
  "properties": {
    "schema_version": {"const": "ATIS-OC-RECONCILIATION-SNAPSHOT-V1"},
    "observation_id": {
      "type": "string",
      "pattern": "^atis:operator-console:reconciliation-observation:v1:sha256:[0-9a-f]{64}$"
    },
    "source_authority": {"const": "RESEARCH_SIMULATION_TRUTH_NO_TRADING_AUTHORITY"},
    "source_run_id": {
      "type": "string",
      "pattern": "^atis:research:run:v1:sha256:[0-9a-f]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "dataset_id", "evidence_id", "content_digest"],
        "properties": {
          "source_id": {"type": "string"},
          "dataset_id": {"type": "string"},
          "evidence_id": {"type": "string"},
          "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reconciliation_state": {
      "enum": ["RECONCILED", "DISCREPANCY", "INVALID_OR_UNKNOWN"]
    },
    "discrepancy_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "MISSING_ORDER", "MISSING_FILL", "MISSING_LEDGER_EVENT",
          "DUPLICATE_ORDER", "DUPLICATE_FILL", "DUPLICATE_LEDGER_POSTING",
          "IDENTITY_MISMATCH", "INSTRUMENT_MISMATCH", "QUANTITY_MISMATCH",
          "SIDE_MISMATCH", "CURRENCY_MISMATCH", "TIMING_MISMATCH",
          "ATTRIBUTION_MISMATCH", "COST_MISMATCH", "LEDGER_STATE_MISMATCH",
          "INVALID_INPUT"
        ]
      }
    },
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "produced_at_utc": {"type": "string", "format": "date-time"},
    "freshness_state": {"const": "UNVERIFIED"},
    "simulation_only": {"const": true},
    "trading_authority": {"const": "NO_TRADING_AUTHORITY"},
    "performance": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gross_pnl", "commission_fees", "bid_ask_spread", "slippage",
            "market_impact", "additional_friction", "net_pnl", "realised_pnl",
            "unrealised_pnl", "portfolio_value", "turnover", "participation", "capacity"
          ],
          "properties": {
            "gross_pnl": {"type": "string"},
            "commission_fees": {"type": "string"},
            "bid_ask_spread": {"type": "string"},
            "slippage": {"type": "string"},
            "market_impact": {"type": "string"},
            "additional_friction": {"type": "string"},
            "net_pnl": {"type": "string"},
            "realised_pnl": {"type": "string"},
            "unrealised_pnl": {"type": "string"},
            "portfolio_value": {"type": "string"},
            "turnover": {"type": "string"},
            "participation": {"const": "NOT_ESTABLISHED"},
            "capacity": {"const": "NOT_ESTABLISHED"}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"reconciliation_state": {"const": "RECONCILED"}}},
      "then": {
        "properties": {
          "discrepancy_codes": {"maxItems": 0},
          "performance": {"type": "object"}
        }
      },
      "else": {
        "properties": {
          "discrepancy_codes": {"minItems": 1},
          "performance": {"type": "null"}
        }
      }
    }
  ]
}
