{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atis.invalid/schemas/engineering-foundation-execution-contract-v1.json",
  "title": "ATIS engineering foundation execution contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "task_id", "owner_authorization_ref", "objective",
    "repository", "authorized_changed_paths", "dependency_inventory", "candidate",
    "environment", "validation_profile", "evidence", "pre_seal_requirements",
    "post_seal_requirements", "downstream_certification", "authority_exclusions"
  ],
  "properties": {
    "contract_version": {"const": "ATIS_ENGINEERING_FOUNDATION_EXECUTION_V1"},
    "task_id": {"type": "string", "minLength": 1},
    "owner_authorization_ref": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "name", "protected_commit", "protected_tree"],
      "properties": {
        "owner": {"const": "KiloAlpha021"},
        "name": {"const": "automated-trading-bot"},
        "protected_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "protected_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "authorized_changed_paths": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^(?!/|.*(?:^|/)\\.\\.(?:/|$)|[A-Za-z]:).*"}
    },
    "dependency_inventory": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["producer", "consumer", "interface", "applicability", "validation", "evidence"],
        "properties": {
          "producer": {"type": "string", "minLength": 1},
          "consumer": {"type": "string", "minLength": 1},
          "interface": {"type": "string", "minLength": 1},
          "applicability": {"type": "string", "minLength": 1},
          "validation": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "expected_parent"],
      "properties": {
        "mode": {"enum": ["PRE_SEAL_WORKING_TREE", "POST_SEAL_IMMUTABLE_COMMIT"]},
        "expected_parent": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["python_version", "dependency_lock_path", "dependency_lock_sha256", "pytest_state_directory"],
      "properties": {
        "python_version": {"const": [3, 12, 10]},
        "dependency_lock_path": {"const": "requirements-dev.lock"},
        "dependency_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pytest_state_directory": {"type": "string", "minLength": 3}
      }
    },
    "validation_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "controls"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "controls": {"type": "array", "minItems": 13, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["output_directory", "no_overwrite", "canonical_serialization"],
      "properties": {
        "output_directory": {"type": "string", "minLength": 3},
        "no_overwrite": {"const": true},
        "canonical_serialization": {"const": "JSON_SORTED_COMPACT_UTF8_SHA256"}
      }
    },
    "pre_seal_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "post_seal_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "downstream_certification": {
      "type": "object", "additionalProperties": false,
      "required": ["obligations"],
      "properties": {"obligations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}
    },
    "authority_exclusions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"candidate": {"properties": {"mode": {"const": "POST_SEAL_IMMUTABLE_COMMIT"}}}}},
      "then": {"properties": {"candidate": {"properties": {"expected_parent": {"type": "string"}}}}}
    }
  ]
}
